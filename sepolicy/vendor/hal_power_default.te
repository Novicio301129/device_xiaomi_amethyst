allow hal_power_default proc_walt:dir search;
allow hal_power_default proc_walt:file rw_file_perms;
allow hal_power_default vendor_sysfs_msm_perf:file rw_file_perms;
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# Bypass Charging & Power Supply Nodes (Fix for Silent Fail & Thermal Daemon Overrides)
allow hal_power_default vendor_sysfs_power_supply:dir r_dir_perms;
allow hal_power_default vendor_sysfs_power_supply:file rw_file_perms;
allow hal_power_default vendor_sysfs_power_supply:lnk_file read;

allow hal_power_default vendor_sysfs_battery_supply:dir r_dir_perms;
allow hal_power_default vendor_sysfs_battery_supply:file rw_file_perms;
allow hal_power_default vendor_sysfs_battery_supply:lnk_file read;

allow hal_power_default vendor_sysfs_qcom_battery:dir r_dir_perms;
allow hal_power_default vendor_sysfs_qcom_battery:file rw_file_perms;
allow hal_power_default vendor_sysfs_qcom_battery:lnk_file read;
