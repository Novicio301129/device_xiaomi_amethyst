# Battery Saving
persist.radio.add_power_save=1
ro.ril.disable.power.collapse=0
ro.ril.fast.dormancy.rule=1
ro.ril.fast.dormancy.timeout=3

# CNE
persist.vendor.cne.feature=1

# Device
ro.product.mod_device=amethyst_global

# GNSS
persist.sys.gps.selfRecovery=3
persist.vendor.overlay.izat.optin=rro

# Dex2oat / ART
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.image-dex2oat-threads=8
dalvik.vm.boot-dex2oat-threads=8
dalvik.vm.dex2oat-threads=6
dalvik.vm.dex2oat-cpu-set=0,1,2,3,4,5
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.dex2oat-resolve-startup-strings=true

# HWUI
ro.hwui.render_ahead=1

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.media.recorder-max-base-layer-fps=60
ro.media.xml_variant.profiles=_volcano_amethyst_v0

# QTI
ro.vendor.qti.va_aosp.support=1

# Radio
persist.vendor.data.mode=concurrent
persist.vendor.radio.atfwd.start=true
ril.subscription.types=NV,RUIM
ro.radio.device_type=1
ro.telephony.default_network=33,33
ro.vendor.use_data_netmgrd=true
telephony.lteOnCdmaDevice=1

# Volume Steps (Framework System Props)
ro.config.alarm_vol_steps=15
ro.config.media_vol_default=15
ro.config.media_vol_steps=25
ro.config.system_vol_steps=15
ro.config.vc_call_vol_steps=11

# Fling & Framework
ro.min.fling_velocity=160
ro.max.fling_velocity=20000

# Miscellaneous System Props
keyguard.no_require_sim=true
persist.sys.fuse.passthrough.enable=true
wifi.aware.interface=wifi-aware0
